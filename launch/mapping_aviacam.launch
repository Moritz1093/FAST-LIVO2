<launch>
<!-- Launch file for the AVIACAM scanner (Livox Avia + compressed camera images, no republish node needed) -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livo)/config/aviacam.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/camera_aviacam.yaml" />
	</node>

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
</launch>
